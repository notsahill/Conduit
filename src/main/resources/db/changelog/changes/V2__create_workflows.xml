<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2" author="sahil">
        <createTable tableName="workflows">
            <column name="id" type="VARCHAR(26)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="workflow_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="current_step" type="INTEGER"/>
            <column name="retry_count" type="INTEGER"/>
            <column name="input_payload" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="creation_time" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_updated_time" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <createIndex tableName="workflows" indexName="idx_workflows_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
