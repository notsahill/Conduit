<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="4" author="sahil">
        <createTable tableName="task_messages">
            <column name="id" type="VARCHAR(26)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(255)"/>
            <column name="workflow_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="step_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="processed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="creation_time" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_updated_time" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addUniqueConstraint tableName="task_messages"
                             columnNames="idempotency_key"
                             constraintName="uq_task_messages_idempotency_key"/>

        <createIndex tableName="task_messages" indexName="idx_task_messages_workflow_id">
            <column name="workflow_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
